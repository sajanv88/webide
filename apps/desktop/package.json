{
  "name": "@repo/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "node scripts/stage-typescript.mjs && node scripts/stage-js-debug.mjs && node scripts/stage-language-servers.mjs && vite",
    "build": "node scripts/stage-typescript.mjs && node scripts/stage-js-debug.mjs && node scripts/stage-language-servers.mjs && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "tauri": "tauri",
    "stage:typescript": "node scripts/stage-typescript.mjs",
    "stage:js-debug": "node scripts/stage-js-debug.mjs",
    "stage:language-servers": "node scripts/stage-language-servers.mjs"
  },
  "dependencies": {
    "@nuvui/backgrounds": "catalog:",
    "@nuvui/chat": "catalog:",
    "@nuvui/icons": "catalog:",
    "@nuvui/react": "catalog:",
    "@repo/assistant": "workspace:*",
    "@repo/commands": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/debug": "workspace:*",
    "@repo/editor-surface": "workspace:*",
    "@repo/explorer": "workspace:*",
    "@repo/git": "workspace:*",
    "@repo/ipc": "workspace:*",
    "@repo/kernel": "workspace:*",
    "@repo/lsp": "workspace:*",
    "@repo/mcp": "workspace:*",
    "@repo/search": "workspace:*",
    "@repo/settings": "workspace:*",
    "@repo/shell": "workspace:*",
    "@repo/tabs": "workspace:*",
    "@repo/terminal": "workspace:*",
    "@repo/trust": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@angular/language-server": "catalog:",
    "@repo/tsconfig": "workspace:*",
    "@tauri-apps/cli": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "esbuild": "catalog:",
    "sass": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vscode-langservers-extracted": "catalog:",
    "yaml-language-server": "catalog:"
  }
}
