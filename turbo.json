{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["TAURI_ENV_*"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "boundaries": {
    "tags": {
      "foundation": {
        "dependencies": {
          "deny": ["infra", "feature", "app"]
        }
      },
      "infra": {
        "dependencies": {
          "deny": ["feature", "app"]
        }
      },
      "feature": {
        "dependencies": {
          "deny": ["infra", "feature", "app"]
        }
      }
    }
  }
}
